# =============================================================================
# Practical 11: Docker Environment Configuration Template
# File: .env.docker.example
# Description: Example environment variables for Docker Compose orchestration.
# Copy to .env.docker or configure via host environment.
# DO NOT COMMIT REAL PRODUCTION SECRETS OR PASSWORDS TO VERSION CONTROL.
# =============================================================================

# Server Environment
NODE_ENV=production
PORT=5000

# Database Configuration (uses 'mongo' Docker service name in taskmanager-network)
MONGO_URI=mongodb://mongo:27017/taskmanager

# Authentication & Security Secret
JWT_SECRET=your_jwt_secret_key_practical11_example

# In-Memory Cache TTL (seconds)
CACHE_TTL=60

# Frontend API Base URL for Nginx Proxy
VITE_API_BASE_URL=/api
