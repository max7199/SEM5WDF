# =============================================================================
# Practical 11: Docker Ignore Patterns
# File: .dockerignore
# Description: Prevents local bloat, dependencies, and sensitive files from being copied
# Student: Max Patel (24IT070) - CHARUSAT - ITUE301
# =============================================================================

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and sensitive configuration
.env
.env.local
.env.*.local
*.pem
*.key

# Git version control
.git
.gitignore
.github

# Build and distribution directories
dist
build
coverage

# Temporary and log files
*.log
logs
temp
tmp
.DS_Store
Thumbs.db

# Documentation and screenshots (not required in runtime container)
screenshots
docs
*.md

# Editor and IDE configurations
.vscode
.idea
.gemini
